# Copy this file to .env and set MQTT_PUBLIC_HOST to this computer's LAN IPv4.
POSTGRES_DB=iotagri
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
# Local host port for pgAdmin. This is bound to 127.0.0.1 in compose.yaml.
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@iotagri.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-local-password
JWT_KEY=change-this-local-jwt-signing-key-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Change-this-admin-password-1!
ADMIN_BOOTSTRAP_FULL_NAME=IOTAgri Administrator
API_PORT=8080
MQTT_PORT=1883
MQTT_PUBLIC_HOST=192.168.12.140

# Email verification / Google sign-in are optional in local development.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_STARTTLS=
EMAIL_VERIFICATION_PEPPER=
GOOGLE_ALLOWED_CLIENT_ID_0=
GOOGLE_ALLOWED_CLIENT_ID_1=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_SERVER_CLIENT_ID=

# Optional Docker device simulator. The owner account must already exist.
MOCK_DEVICE_ENABLED=false
MOCK_DEVICE_OWNER_EMAIL=cac@gmail.com
MOCK_DEVICE_KEY=docker-mock-cac-device
MOCK_DEVICE_NAME=Aerogreen Docker Mock
SIMULATOR_READING_INTERVAL_SECONDS=5
