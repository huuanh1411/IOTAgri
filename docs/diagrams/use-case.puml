@startuml use-case-guest
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
' Actor ở ngoài khung hệ thống; các use case bố trí so le bên trong.
' SVG do render-use-cases.py xuất giữ bố cục theo hình mẫu UML.
actor "Khách" as Guest
rectangle "IOTAgri" {
  usecase "Đăng ký / Đăng nhập" as GuestUC1
  usecase "Quên mật khẩu / Đặt lại mật khẩu" as GuestUC2
}
Guest -- GuestUC1
Guest -- GuestUC2
@enduml

@startuml use-case-user
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
' Actor ở ngoài khung hệ thống; các use case bố trí so le bên trong.
' SVG do render-use-cases.py xuất giữ bố cục theo hình mẫu UML.
actor "Người dùng\nđã đăng nhập" as User
rectangle "IOTAgri" {
  usecase "Làm mới phiên / Đăng xuất\nQuản lý hồ sơ / Đổi mật khẩu" as UserUC1
  usecase "Thêm / Xem / Sửa / Xóa\nthiết bị sở hữu" as UserUC2
  usecase "Tạo mã ghép nối" as UserUC3
  usecase "Xem dashboard / Trạng thái online" as UserUC4
  usecase "Xem lịch sử / Biểu đồ\nTổng hợp cảm biến" as UserUC5
  usecase "Điều khiển bơm\nXem lịch sử lệnh" as UserUC6
  usecase "Điều khiển đèn / Xem trạng thái" as UserUC7
  usecase "Quản lý lịch bơm / Lịch đèn" as UserUC8
  usecase "Cấu hình ngưỡng\nXem và xử lý cảnh báo" as UserUC9
  usecase "Tạo / Xem / Trao đổi phiếu hỗ trợ" as UserUC10
  usecase "Chọn cây / Theo dõi ngày trồng" as UserUC11 #FFF7DB
  usecase "Cài đặt ứng dụng\nThông báo cục bộ" as UserUC12 #FFF7DB
}
User -- UserUC1
User -- UserUC2
User -- UserUC3
User -- UserUC4
User -- UserUC5
User -- UserUC6
User -- UserUC7
User -- UserUC8
User -- UserUC9
User -- UserUC10
User -- UserUC11
User -- UserUC12
@enduml

