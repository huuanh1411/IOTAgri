@startuml use-case
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
title IOTAgri — Các actor trong cùng một sơ đồ
actor "Khách" as Guest
actor "Người dùng\nđã đăng nhập" as User
actor "Quản trị viên" as Admin
actor "Thiết bị ESP32" as ESP
actor "Dịch vụ email SMTP" as SMTP

rectangle "IOTAgri" {
  usecase "Đăng ký / Đăng nhập" as GuestUC1
  usecase "Quên mật khẩu / Đặt lại mật khẩu" as GuestUC2
  usecase "Làm mới phiên / Đăng xuất\nQuản lý hồ sơ / Đổi mật khẩu" as UserUC1
  usecase "Thêm / Xem / Sửa / Xóa\nthiết bị sở hữu" as UserUC2
  usecase "Tạo mã ghép nối" as UserUC3
  usecase "Xem dashboard / Trạng thái online" as UserUC4
  usecase "Xem lịch sử / Biểu đồ\nTổng hợp cảm biến" as UserUC5
  usecase "Điều khiển bơm\nXem lịch sử lệnh" as UserUC6
  usecase "Điều khiển đèn / Xem trạng thái" as UserUC7
  usecase "Quản lý lịch bơm / Lịch đèn" as UserUC8
  usecase "Cấu hình ngưỡng\nXem và xử lý cảnh báo" as UserUC9
  usecase "Tạo / Xem / Trao đổi phiếu hỗ trợ" as UserUC10
  usecase "Chọn cây / Theo dõi ngày trồng" as UserUC11 #FFF7DB
  usecase "Cài đặt ứng dụng\nThông báo cục bộ" as UserUC12 #FFF7DB
  usecase "Xem tài khoản / Phân quyền\nKhóa và mở khóa" as AdminUC2
  usecase "Xem mọi thiết bị / Dữ liệu\nChuyển chủ sở hữu" as AdminUC3
  usecase "Xem tổng quan / Báo cáo / Xuất CSV" as AdminUC4
  usecase "Xem trạng thái hệ thống\nCấu hình ngưỡng mặc định" as AdminUC5
  usecase "Xem nhật ký quản trị" as AdminUC6
  usecase "Phản hồi / Đổi trạng thái\nvà ưu tiên phiếu hỗ trợ" as AdminUC7
  usecase "Ghép nối phần cứng bằng mã" as ESPUC1
  usecase "Gửi và lưu số liệu cảm biến" as ESPUC2
  usecase "Nhận lệnh bơm, đèn\nGửi trạng thái" as ESPUC3
}

Guest -- GuestUC1
Guest -- GuestUC2
User -- UserUC1
User -- UserUC2
User -- UserUC3
User -- UserUC4
User -- UserUC5
User -- UserUC6
User -- UserUC7
User -- UserUC8
User -- UserUC9
User -- UserUC10
User -- UserUC11
User -- UserUC12
Admin -- UserUC1
Admin -- AdminUC2
Admin -- AdminUC3
Admin -- AdminUC4
Admin -- AdminUC5
Admin -- AdminUC6
Admin -- AdminUC7
ESP -- ESPUC1
ESP -- ESPUC2
ESP -- ESPUC3
SMTP -- GuestUC2
@enduml
