@startuml use-case
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
title IOTAgri — All actors in one diagram
actor "Guest" as Guest
actor "Authenticated\nUser" as User
actor "Administrator" as Admin
actor "ESP32 device" as ESP
actor "SMTP email\nservice" as SMTP

rectangle "IOTAgri" {
  usecase "Sign up / Sign in" as GuestUC1
  usecase "Forgot password / Reset password" as GuestUC2
  usecase "Refresh session / Sign out\nManage profile / Change password" as UserUC1
  usecase "Add / View / Edit / Delete\nowned devices" as UserUC2
  usecase "Generate pairing code" as UserUC3
  usecase "View dashboard / Online status" as UserUC4
  usecase "View history / Charts\nSensor aggregates" as UserUC5
  usecase "Control pump\nView command history" as UserUC6
  usecase "Control light / View status" as UserUC7
  usecase "Manage pump / Light schedules" as UserUC8
  usecase "Configure thresholds\nView and resolve alerts" as UserUC9
  usecase "Create / View / Discuss\nsupport tickets" as UserUC10
  usecase "Select crops / Track planting dates" as UserUC11 #FFF7DB
  usecase "App settings\nLocal notifications" as UserUC12 #FFF7DB
  usecase "View accounts / Assign roles\nLock and unlock accounts" as AdminUC2
  usecase "View all devices / Data\nTransfer ownership" as AdminUC3
  usecase "View overview / Reports / Export CSV" as AdminUC4
  usecase "View system status\nConfigure default thresholds" as AdminUC5
  usecase "View admin audit logs" as AdminUC6
  usecase "Reply / Update status\nand ticket priority" as AdminUC7
  usecase "Pair hardware using a code" as ESPUC1
  usecase "Send and store sensor readings" as ESPUC2
  usecase "Receive pump and light commands\nReport status" as ESPUC3
}

Guest -- GuestUC1
Guest -- GuestUC2
User -- UserUC1
User -- UserUC2
User -- UserUC3
User -- UserUC4
User -- UserUC5
User -- UserUC6
User -- UserUC7
User -- UserUC8
User -- UserUC9
User -- UserUC10
User -- UserUC11
User -- UserUC12
Admin -- UserUC1
Admin -- AdminUC2
Admin -- AdminUC3
Admin -- AdminUC4
Admin -- AdminUC5
Admin -- AdminUC6
Admin -- AdminUC7
ESP -- ESPUC1
ESP -- ESPUC2
ESP -- ESPUC3
SMTP -- GuestUC2
@enduml
