@startuml use-case-overview-guest
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
' Actor ở ngoài khung hệ thống; các use case bố trí so le bên trong.
' SVG do render-use-cases.py xuất giữ bố cục theo hình mẫu UML.
actor "Khách" as Guest
rectangle "IOTAgri" {
  usecase "UC-01: Đăng ký / Đăng nhập" as GuestUC1
  usecase "UC-03: Quên / Đặt lại mật khẩu" as GuestUC2
}
Guest -- GuestUC1
Guest -- GuestUC2
@enduml

@startuml use-case-overview-user
left to right direction
