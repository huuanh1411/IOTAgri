@startuml use-case-overview
left to right direction
skinparam actorStyle stickman
skinparam shadowing false
skinparam linetype polyline
skinparam usecaseBorderColor #7138A0
skinparam rectangleBackgroundColor #F1EEF5
title IOTAgri — All actors in one diagram
actor "Guest" as Guest
actor "Authenticated\nUser" as User
actor "Administrator" as Admin
actor "ESP32 device" as ESP
actor "SMTP email\nservice" as SMTP

rectangle "IOTAgri" {
  usecase "UC-01: Sign up / Sign in" as GuestUC1
  usecase "UC-03: Forgot / Reset password" as GuestUC2
  usecase "UC-02,04: Session / Profile / Password" as UserUC1
  usecase "UC-05–06: Devices / Pairing codes" as UserUC2
  usecase "UC-08–12: Monitoring / Control\nSchedules / Alerts" as UserUC3
  usecase "UC-13: Create / View / Discuss\nsupport tickets" as UserUC4
  usecase "UC-17: Crops / Local settings" as UserUC5 #FFF7DB
  usecase "UC-13: Reply / Manage tickets" as AdminUC2
  usecase "UC-14–15: System-wide\naccounts / Devices" as AdminUC3
  usecase "UC-16: Reports / Configuration\nAdmin audit logs" as AdminUC4
  usecase "UC-06: Pair hardware using a code" as ESPUC1
  usecase "UC-07: Send sensor readings" as ESPUC2
  usecase "UC-18: Receive pump/light commands\nReport status" as ESPUC3
}

Guest -- GuestUC1
Guest -- GuestUC2
User -- UserUC1
User -- UserUC2
User -- UserUC3
User -- UserUC4
User -- UserUC5
Admin -- UserUC1
Admin -- AdminUC2
Admin -- AdminUC3
Admin -- AdminUC4
ESP -- ESPUC1
ESP -- ESPUC2
ESP -- ESPUC3
SMTP -- GuestUC2
@enduml
