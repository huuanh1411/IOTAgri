api.aerogreen.vn {
	encode gzip
	reverse_proxy api:8080
}

app.aerogreen.vn aerogreen.vn {
	encode gzip
	reverse_proxy frontend:80
}

www.aerogreen.vn {
	redir https://aerogreen.vn{uri} permanent
}

# Caddy only obtains and renews this certificate; deploy/sync-mqtt-certs.sh hands it to Mosquitto.
mqtt.aerogreen.vn {
	respond 404
}
